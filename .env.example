# Copy this file to `.env` and replace the placeholder values.
# `.env` is gitignored and must never be committed.

# Password for the PostgreSQL `loanapp` user.
POSTGRES_PASSWORD=change-me

# Signing key for JWT access tokens (HS256).
# Use at least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# `Development` also exposes the Scalar API reference at /scalar/v1.
ASPNETCORE_ENVIRONMENT=Development
